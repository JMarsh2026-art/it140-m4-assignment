# IT 140 Module Four Assignment
# Higher/Lower Game Pseudocode Template
#
# Complete the TODO prompts below with your own pseudocode.
# Keep this file in .pseudo format for submission.
#
# Use clear indentation to show decisions and repeated behavior.
# Your finished pseudocode should address every requirement in the
# current Module Four Assignment Guidelines and Rubric.

START hilow_game

    PRINT ("Welcome to the higher/lower game")

// Loop to ensure valid bounds
REPEAT
    PRINT ("Enter the lower bounds: "
    INPUT lower_bound
    PRINT ("enter the upper bound: "
    INPUT upper_bound
    If lower_bound>= upper_bound THEN
        PRINT ("The lower bound must be less than the upper bound.")
    ENDIF
UNTIL lower_bound < upper_bound

// Generate the target random number within the bounds
secret_number = GENERATE_RANDOM_NUMBER(lower_bound), upper_bound)

// Initial Guess
    PRINT ("Great, now guess a number between" + lower_bound + "and " + upper_bound + ": "
    INPUT (guess)

// Guessing loop
WHILE guess! = secret_number DO
    IF guess < secret_number THEN
        PRINT ("Nope, too low.")
    ELSE
        PRINT ("Nope, too high.")
    ENDIF

    PRINT ("Guess another number: "
    INPUT guess
ENDWHILE

// Success message when the loop terminates
PRINT ("You got it!")
END
END hilow_game

